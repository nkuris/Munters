# Example environment variables for docker-compose
# Copy this file to .env and replace placeholders before running the stack.
GIPHY__APIKEY=your_giphy_api_key_here
# Optional: comma-separated list of allowed CORS origins (used by Munters.Server)
# Example: Cors__AllowedOrigins=http://localhost:3000,http://munters.client:80
Cors__AllowedOrigins=http://localhost:3000,http://munters.client:80
